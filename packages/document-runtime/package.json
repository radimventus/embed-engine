{
  "name": "@embed-engine/document-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PT-15 — Document Runtime (registry · generator · PDF · versioning)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node.ts",
      "import": "./src/node.ts",
      "default": "./src/node.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "generate:deal-templates": "node scripts/generate-deal-templates.mjs",
    "pretypecheck": "pnpm run generate:deal-templates",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm run generate:deal-templates",
    "test": "tsx --test src/documentRuntime.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.6",
    "@zxing/library": "^0.23.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "pdf-lib": "1.17.1",
    "qrcode": "^1.5.4"
  }
}
