{
  "name": "@embed-engine/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./session": {
      "types": "./dist/session/index.d.ts",
      "import": "./dist/session/index.js",
      "default": "./dist/session/index.js"
    },
    "./priority": {
      "types": "./dist/priority/index.d.ts",
      "import": "./dist/priority/index.js",
      "default": "./dist/priority/index.js"
    },
    "./priority/mock": {
      "types": "./dist/priority/mock/index.d.ts",
      "import": "./dist/priority/mock/index.js",
      "default": "./dist/priority/mock/index.js"
    },
    "./priority/html-renderer": {
      "types": "./dist/priority/html-renderer/index.d.ts",
      "import": "./dist/priority/html-renderer/index.js",
      "default": "./dist/priority/html-renderer/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/priority/PriorityRuntimeEngine.test.ts src/priority/mock/createGardenJourneyRun.test.ts src/priority/html-renderer/renderPriorityJourney.test.ts src/session/DecisionSession.test.ts",
    "demo:priority": "vite --config demo/priority-html/vite.config.ts"
  },
  "dependencies": {
    "@embed-engine/core": "workspace:*",
    "@embed-engine/model": "workspace:*",
    "@embed-engine/object-house": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^6.0.0"
  }
}
