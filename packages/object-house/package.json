{
  "name": "@embed-engine/object-house",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./loader": {
      "types": "./dist/loader/index.d.ts",
      "import": "./dist/loader/index.js"
    },
    "./builder-package": {
      "types": "./dist/builder-package/index.d.ts",
      "import": "./dist/builder-package/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/behavior/composeDispositionLayout.test.ts src/behavior/spliceStairsWarn.test.ts src/behavior/decisionFactors.test.ts src/loader/loadHousePackage.test.ts src/projectHouse.test.ts src/builder-package/importBuilderHousePackage.test.ts"
  },
  "dependencies": {
    "@embed-engine/core": "workspace:*",
    "@embed-engine/model": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
