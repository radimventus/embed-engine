{
  "name": "@embed-engine/embed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/embed.es.js",
  "module": "./dist/embed.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/embed.es.js",
      "default": "./dist/embed.es.js"
    }
  },
  "files": [
    "dist",
    "DISTRIBUTION.md"
  ],
  "scripts": {
    "build": "node ./scripts/build-distribution.mjs",
    "publish:release": "node ./scripts/publish-release.mjs",
    "sync:pages": "pnpm run publish:release",
    "smoke:runtime": "node ./scripts/smoke-runtime.mjs",
    "validate:pages": "node ./scripts/validate-pages.mjs",
    "deploy:pages": "pnpm run publish:release",
    "ssot:guard": "tsx --test scripts/ssot-guard.test.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/Embed.test.ts src/fixtures.test.ts src/delivery/deliveryLayer.test.ts src/delivery/revealEngine.test.ts src/delivery/cssIsolation.test.ts src/delivery/resolveProductionAssetBase.test.ts scripts/ssot-guard.test.ts",
    "demo": "vite --config demo/vite.config.ts"
  },
  "dependencies": {
    "@embed-engine/contracts": "workspace:*",
    "@embed-engine/core": "workspace:*",
    "@embed-engine/decision": "workspace:*",
    "@embed-engine/design-tokens": "workspace:*",
    "@embed-engine/kernel": "workspace:*",
    "@embed-engine/model": "workspace:*",
    "@embed-engine/object-house": "workspace:*",
    "@embed-engine/runtime": "workspace:*",
    "@embed-engine/ui": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "happy-dom": "^17.4.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^6.0.0"
  }
}
