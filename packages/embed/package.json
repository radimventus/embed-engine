{
  "name": "@embed-engine/embed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/embed.es.js",
  "module": "./dist/embed.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/embed.es.js",
      "default": "./dist/embed.es.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.iife.config.ts && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/Embed.test.ts src/fixtures.test.ts",
    "demo": "vite --config demo/vite.config.ts"
  },
  "dependencies": {
    "@embed-engine/core": "workspace:*",
    "@embed-engine/runtime": "workspace:*"
  },
  "devDependencies": {
    "happy-dom": "^17.4.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^6.0.0"
  }
}
