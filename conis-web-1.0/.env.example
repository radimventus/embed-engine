# Required for live lead delivery (without these, leads are archived locally only)

# SMTP → kontakt@conis.cz
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
LEAD_EMAIL_TO=kontakt@conis.cz
LEAD_EMAIL_FROM=kontakt@conis.cz

# Google Sheets Apps Script web app (doPost JSON)
# Row: timestamp, name, company, email, phone, answers, status, userAgent, ip
GOOGLE_SHEETS_WEBHOOK_URL=

