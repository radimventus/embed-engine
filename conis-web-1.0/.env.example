# Required for live lead delivery (without these, leads are archived locally only)

# SMTP → kontakt@conis.cz (local Node path only; production uses Apps Script Gmail)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
LEAD_EMAIL_TO=kontakt@conis.cz
LEAD_EMAIL_FROM=kontakt@conis.cz

# Google Apps Script Web App URL (CAP-WEB-01)
# Same URL as <meta name="conis-lead-endpoint"> on production Pages.
# Spreadsheet ID + NOTIFICATION_EMAIL live in Apps Script Script properties — not here.
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbzQ2-YW9DputxDhBVLGRK8byxhLfoju1Obo5OneqAABWK6KuQubzDwM8zLz2z_yDKTj3g/exec

# PORT=3000
