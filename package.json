{
    "name": "embed-engine",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@11.13.0",
    "scripts": {
      "build": "turbo run build",
      "dev": "turbo run dev",
      "lint": "turbo run lint",
      "test": "turbo run test",
      "typecheck": "turbo run typecheck",
      "format": "prettier --write .",
      "reference": "pnpm --filter @embed-engine/client-studio reference",
      "reference:freeze": "pnpm --filter @embed-engine/client-studio reference:freeze"
    },
    "devDependencies": {
      "prettier": "^3.6.2",
      "turbo": "^2.5.6",
      "typescript": "^5.9.2"
    }
  }
  